# 把本文件复制为 deployment/secrets.env；secrets.env 已被 Git 忽略，禁止提交或发送给他人。
# 密码建议只使用英文字母、数字和常见符号。单引号会破坏本文件的 Shell 格式，密码中不要包含单引号或换行。

# MySQL 的 root 管理密码。只给数据库初始化和 Jenkins 部署用，不用于应用连接。
# 示例：MYSQL_ROOT_PASSWORD='RootDb_2026!k8s'
MYSQL_ROOT_PASSWORD=''

# 应用 app 账号的 MySQL 密码。后端通过它连接数据库，应与 root 密码不同。
# 示例：MYSQL_PASSWORD='AppDb_2026!k8s'
MYSQL_PASSWORD=''

# Docker Hub 用户名。Jenkins 使用它和下方 Token 推送 frontend/backend 镜像。
# 示例：DOCKERHUB_USERNAME='staystar'
DOCKERHUB_USERNAME='staystar'

# Docker Hub Personal Access Token，权限必须是 Read & Write；粘贴 token 原文，不要加“Bearer”。
# 示例形态：DOCKERHUB_TOKEN='dckr_pat_abcdefghijklmnopqrstuvwxyz0123456789'
DOCKERHUB_TOKEN=''

# Jenkins 网页的管理员用户名。部署完成后用它登录 http://Master公网IP:30081。
# 示例：JENKINS_ADMIN_USER='staystar-admin'
JENKINS_ADMIN_USER=''

# Jenkins 网页的管理员密码。它不是 Docker Hub Token，也不是 SSH 私钥密码。
# 示例：JENKINS_ADMIN_PASSWORD='Jenkins_2026!admin'
JENKINS_ADMIN_PASSWORD=''

# GitHub 仓库 HTTPS 地址。Jenkins 从这里拉取 Jenkinsfile、前端和后端代码；当前公开仓库可直接使用。
# 示例：GITHUB_REPOSITORY_URL='https://github.com/StayStar/k8s.git'
GITHUB_REPOSITORY_URL='https://github.com/StayStar/k8s.git'

# Jenkins 自动创建的流水线任务名。一般保留 fullstack-pipeline 即可；仅使用小写字母、数字和连字符。
# 示例：JENKINS_JOB_NAME='fullstack-pipeline'
JENKINS_JOB_NAME='fullstack-pipeline'
